[configuration]
entry_symbol = "gdextension_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]
windows.debug.x86_64 = "bin/windows/godot_gameplay_attributes.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/windows/godot_gameplay_attributes.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "bin/linux/libgodot_gameplay_attributes.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/linux/libgodot_gameplay_attributes.linux.template_release.x86_64.so"
linux.debug.arm64 = "bin/linux/libgodot_gameplay_attributes.linux.template_debug.arm64.so"
linux.debug.rv64 = "bin/linux/libgodot_gameplay_attributes.linux.template_debug.rv64.so"
android.debug.arm32 = "bin/android/libgodot_gameplay_attributes.android.template_debug.arm32.so"
android.debug.arm64 = "bin/android/libgodot_gameplay_attributes.android.template_debug.arm64.so"
macos.debug = "bin/macos/macos.framework/libgodot_gameplay_attributes.macos.template_debug"
macos.release = "bin/macos/macos.framework/libgodot_gameplay_attributes.macos.template_release"
